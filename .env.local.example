# Copy to .env.local and fill in. Every key is optional: the app runs without
# any of them (canned itineraries, no persistence, no email) and lights up each
# capability the moment its key is present.

# ── Claude: itinerary generation + brief improver (server-side only) ──
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ── Firebase: anonymous auth + Firestore (trips + leads) ──
# console.firebase.google.com → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Resend: emails the reserved traveler their plan ──
# resend.com → API keys. To email anyone, verify a domain and set RESEND_FROM
# to an address on it (e.g. "Tripcraft <hello@yourdomain.com>"). Without a
# verified domain Resend only delivers to your own account email.
RESEND_API_KEY=
RESEND_FROM=
