# Copy to .env.local and fill in. EVERY key is optional — the app runs fully
# without any of them (canned itineraries + simulated checkout + no persistence)
# and upgrades each capability the moment its keys are present.

# ── Claude itinerary generation (server-side only) ──────────────
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ── Stripe deposit (in-app Payment Element) ─────────────────────
# dashboard.stripe.com → Developers → API keys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Deposit in the currency's SMALLEST unit. IDR is 2-decimal in Stripe,
# so IDR 750.000 = 75000000. Your Stripe account must support IDR.
STRIPE_DEPOSIT_AMOUNT=75000000
STRIPE_DEPOSIT_CURRENCY=idr

# ── Firebase (anonymous auth + Firestore) ───────────────────────
# console.firebase.google.com → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
