# Copy to .env.local and fill in. Every key is optional: the app runs without
# any of them (canned itineraries, no persistence, no email) and lights up each
# capability the moment its key is present.

# ── Claude: itinerary generation + brief improver (server-side only) ──
# console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ── Firebase: anonymous auth + Firestore (trips + leads) ──
# console.firebase.google.com → Project settings → Web app config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Email (plan + booking confirmations). Two options, no domain needed: ──
#
# OPTION A — Gmail SMTP (recommended, no domain to own/verify). Sends from your
# @gmail to ANY recipient. Setup: turn on 2-Step Verification on the Google
# account, then Google Account → Security → App passwords → create one for
# "Mail". Put the 16-char password below (spaces are fine).
GMAIL_USER=
GMAIL_APP_PASSWORD=
#
# OPTION B — Resend. Only delivers to arbitrary recipients once you verify a
# domain and set RESEND_FROM to an address on it. Without that it only reaches
# your own Resend account email. Used as a fallback if Gmail isn't set.
RESEND_API_KEY=
RESEND_FROM=

# ── Google Places (New): real photos, ratings, reviews per place ──
# console.cloud.google.com → enable "Places API (New)" → create an API key.
# Restrict the key (HTTP referrers + Places API only) before going live.
GOOGLE_MAPS_API_KEY=

# ── Upstash Redis: durable rate limiting across serverless instances ──
# upstash.com → create a Redis DB → REST API. Without these the limiter falls
# back to per-instance memory, which does NOT cap spend on Vercel. Set these in
# production so a burst of distinct prompts can't drain Claude credits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
